# Set AT LEAST ONE key below. Providers are tried in this order:
# DashScope (Alibaba Cloud) -> Anthropic -> Google Gemini.
# If one provider is rate-limited or out of quota the next one is used automatically,
# so configuring more than one makes the app more reliable.
#
# Alibaba Cloud Model Studio (OpenAI-compatible). Create a key at
# https://bailian.console.alibabacloud.com/ then copy the "OpenAI Compatible Endpoint"
# URL and API key from the API Quick Access dialog.
DASHSCOPE_API_KEY=your_key_here
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional: pin one provider instead of using the fallback order.
# One of: dashscope | anthropic | gemini
# AI_PROVIDER=dashscope
